<Window x:Class="VAdapter.App.Views.IntegrationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="720" Width="700" MinHeight="600" MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <!-- 下部ボタン -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource PrimaryButton}" Width="90" Margin="0,0,8,0" Click="OnOk">
                <TextBlock Text="OK" Foreground="White"/>
            </Button>
            <Button Width="90" Content="キャンセル" IsCancel="True"/>
        </StackPanel>

        <TabControl Style="{StaticResource SettingsTabControl}">

            <!-- ════════ 連携環境 ════════ -->
            <TabItem Header="連携環境">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- 連携環境セレクタ -->
                        <Border Background="{StaticResource B.Surface}" CornerRadius="8"
                                BorderBrush="{StaticResource B.Border}" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="連携環境" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource B.TextPrimary}"/>
                                <TextBlock Text="音声・字幕の投げ込み先を選択します。マクロ実行はどのモードでも動作します。"
                                           FontSize="11" Foreground="{StaticResource B.TextMuted}" Margin="0,3,0,8" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <RadioButton x:Name="ModeMacro" Content="マクロ動作ベース（YMM4 等）" Margin="0,0,18,6"
                                                 GroupName="Mode" Checked="OnModeChecked"/>
                                    <RadioButton x:Name="ModeAviUtl" Content="AviUtl + PSDToolKit" Margin="0,0,18,6"
                                                 GroupName="Mode" Checked="OnModeChecked"/>
                                    <RadioButton x:Name="ModeAviUtl2" Content="AviUtl2 + PSDToolKit2" Margin="0,0,18,6"
                                                 GroupName="Mode" Checked="OnModeChecked"/>
                                    <RadioButton x:Name="ModeExternal" Content="外部アダプタ（コマンド）"
                                                 GroupName="Mode" Checked="OnModeChecked"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 動画編集ソフトの起動（ランチャー）— 全モード共通 -->
                        <Border x:Name="EditorPathPanel" Background="{StaticResource B.Surface}"
                                CornerRadius="8" BorderBrush="{StaticResource B.Border}" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="動画編集ソフトの起動（ランチャー）" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.TextPrimary}"/>
                                <TextBlock Text="登録すると、メイン画面ヘッダーの電源ボタンからこの編集ソフトを起動できます（環境ごとに登録）。"
                                           FontSize="11" Foreground="{StaticResource B.TextMuted}" Margin="0,3,0,8" TextWrapping="Wrap"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="参照…" Width="70" Margin="8,0,0,0" Click="OnBrowseEditor"/>
                                    <Button DockPanel.Dock="Right" Click="OnLaunchEditorTest">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource I.Power}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Margin="0,0,6,0"/>
                                            <TextBlock Text="起動テスト" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Button>
                                    <Grid>
                                        <TextBox x:Name="EditorPathBox" VerticalContentAlignment="Center"
                                                 TextChanged="OnEditorPathChanged"/>
                                        <TextBlock x:Name="EditorPlaceholderText" IsHitTestVisible="False" FontStyle="Italic"
                                                   Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                    </Grid>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 外部アダプタ（コマンド）設定 -->
                        <Border x:Name="ExternalCmdPanel" Background="{StaticResource B.Surface}"
                                CornerRadius="8" BorderBrush="{StaticResource B.Border}" BorderThickness="1" Padding="14,12"
                                Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="外部アダプタ" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource B.TextPrimary}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource B.TextMuted}" Margin="0,3,0,8"
                                           Text="検知した音声・字幕を中立な payload.json に書き出し、下記コマンドへ渡します（{payload} がファイルパスに置換）。終了コード 0＝成功。編集ソフト固有の取り込みは外部スクリプト側で実装します。"/>
                                <TextBlock Text="コマンドテンプレート" FontSize="12" Margin="0,0,0,2"/>
                                <TextBox x:Name="CommandBox" Margin="0,0,0,8" FontFamily="{StaticResource F.Mono}"
                                         ToolTip="例: python davinci_import.py {payload}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="タイムアウト (ms)" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TimeoutBox" Width="100"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════ 投げ込み ════════ -->
            <TabItem Header="投げ込み">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- マクロ動作ベースの説明 -->
                        <Border x:Name="MacroOnlyPanel" Background="{StaticResource B.HoverBg}"
                                CornerRadius="8" BorderBrush="{StaticResource B.Border}" BorderThickness="1" Padding="16"
                                Visibility="Collapsed">
                            <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource B.TextSecondary}"
                                       Text="マクロ動作ベースでは、V-Adapter はマクロ実行のみを行い、ファイルの投げ込み（監視）は行いません。動画編集ソフト（YMM4 のカスタムボイス等）が音声・字幕を取り込みます。AviUtl / AviUtl2 へ自動で投げ込むには、「連携環境」タブでモードを切り替えてください。"/>
                        </Border>

                        <!-- AviUtl / AviUtl2 / 外部 共通設定 -->
                        <Grid x:Name="AviutlPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 状態 -->
                            <Border Grid.Row="0" Background="{StaticResource B.Surface}" CornerRadius="8"
                                    BorderBrush="{StaticResource B.Border}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="状態更新" Width="90" Click="OnRefreshStatus"/>
                                    <StackPanel>
                                        <TextBlock x:Name="StatusGcmz" Text="ごちゃまぜドロップス: 未確認" FontSize="12"
                                                   Foreground="{StaticResource B.TextSecondary}"/>
                                        <TextBlock x:Name="StatusProject" Text="プロジェクト: 未確認" FontSize="12"
                                                   Foreground="{StaticResource B.TextTertiary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- フォルダ + 数値設定 -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <!-- 監視フォルダは「音声の保存」タブ①へ統合済み -->
                                <Border Grid.Column="0" Background="{StaticResource B.HoverBg}" CornerRadius="8"
                                        BorderBrush="{StaticResource B.Border}" BorderThickness="1" Padding="12,10" Margin="0,0,10,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="監視フォルダ" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                                   Foreground="{StaticResource B.TextSecondary}"
                                                   Text="どのフォルダを見張るかは「音声の保存」タブの ① 保存フォルダ で設定します。投げ込みと後処理は同じフォルダを見るため、ここでは設定しません。"/>
                                    </StackPanel>
                                </Border>

                                <!-- 数値設定 -->
                                <Border Grid.Column="1" Background="{StaticResource B.Surface}" CornerRadius="8"
                                        BorderBrush="{StaticResource B.Border}" BorderThickness="1" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="既定レイヤー" FontSize="12" Margin="0,0,0,2"/>
                                        <TextBox x:Name="DefaultLayerBox" Margin="0,0,0,8"/>
                                        <CheckBox x:Name="AdvanceToItemEndCheck" Content="投入後シークをアイテム終端へ"
                                                  FontSize="12" Margin="0,0,0,8"
                                                  Checked="OnAdvanceToggled" Unchecked="OnAdvanceToggled"/>
                                        <StackPanel x:Name="FrameAdvancePanel">
                                            <TextBlock Text="frameAdvance（手動・上をOFF時）" FontSize="12" Margin="0,0,0,2"/>
                                            <TextBox x:Name="FrameAdvanceBox" Margin="0,0,0,8"/>
                                        </StackPanel>
                                        <TextBlock Text="安定待ち (ms)" FontSize="12" Margin="0,0,0,2"/>
                                        <TextBox x:Name="StableWaitBox" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="MarginPanel">
                                            <TextBlock Text="margin（AviUtl2のみ）" FontSize="12" Margin="0,0,0,2"/>
                                            <TextBox x:Name="MarginBox"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 話者ルール -->
                            <Border Grid.Row="2" Height="220" Background="{StaticResource B.Surface}" CornerRadius="8"
                                    BorderBrush="{StaticResource B.Border}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                        <TextBlock Text="話者ルール（ファイル名→レイヤー）" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource AccentButton}" Margin="0,0,6,0" Click="OnAddRule">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource I.Plus}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" Margin="0,0,6,0"/>
                                                    <TextBlock Text="行を追加" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DangerButton}" Click="OnRemoveRule">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource I.Trash}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" Margin="0,0,6,0"/>
                                                    <TextBlock Text="削除" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="11" Foreground="{StaticResource B.TextMuted}"
                                               TextWrapping="Wrap"
                                               Text="「行を追加」で _話者_ / -話者- を抽出する既定パターンが入ります。話者ごとにレイヤーを分けたい場合は、既定パターンのまま行を追加して話者名を入力してください。上から順に評価されます。"/>
                                    <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26"
                                              Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="有効" Binding="{Binding Enabled}" Width="44"/>
                                            <DataGridTextColumn Header="ファイル名パターン（正規表現）" Binding="{Binding NamePattern}" Width="*"/>
                                            <DataGridTextColumn Header="話者名" Binding="{Binding SpeakerName}" Width="120"/>
                                            <DataGridTextColumn Header="レイヤー" Binding="{Binding Layer}" Width="64"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <!-- ログ + テスト -->
                            <Border Grid.Row="3" Background="{StaticResource B.Surface}" CornerRadius="8"
                                    BorderBrush="{StaticResource B.Border}" BorderThickness="1" Padding="10">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock Text="ログ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button HorizontalAlignment="Right" Click="OnTestDrop">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource I.Import}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" Margin="0,0,6,0"/>
                                                <TextBlock Text="今すぐ投げる（テスト）…" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                    <TextBox x:Name="LogBox" Height="80" IsReadOnly="True" Background="{StaticResource B.HoverBg}"
                                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="8,6"
                                             FontFamily="{StaticResource F.Mono}" FontSize="11" Foreground="{StaticResource B.TextSecondary}"/>
                                </DockPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════ 音声の保存 ════════ -->
            <TabItem Header="音声の保存">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- 全体の流れ -->
                        <Border Background="{StaticResource B.HoverBg}" CornerRadius="8" BorderBrush="{StaticResource B.Border}"
                                BorderThickness="1" Padding="14,11" Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="12"
                                       Foreground="{StaticResource B.TextSecondary}"
                                       Text="① 合成音声ソフトの保存先を V-Adapter が見張り、② 保存されたファイルを整えて、③ 動画編集ソフトに読み込ませる場所へ置きます。設定が必要なのは ① だけで、② ③ は任意です。"/>
                        </Border>

                        <!-- ① 保存フォルダ -->
                        <Border Background="{StaticResource B.Surface}" CornerRadius="8" BorderBrush="{StaticResource B.Border}"
                                BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="① 保存フォルダ（V-Adapter が見張る場所）" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.TextPrimary}"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,8"
                                           Text="合成音声ソフトの「音声の保存」先を、ここに登録したフォルダにしてください。同名の wav と txt が揃った時点で、投げ込み・後処理が動きます。"/>
                                <!-- AlternationCount で行番号を得る。並び替え・追加・削除に自動で追従する。 -->
                                <ListBox x:Name="FolderList" Height="84" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                         HorizontalContentAlignment="Stretch" AlternationCount="999">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- サブフォルダの有無はフォルダごとの設定。行内で直接切り替える。 -->
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Width="18" Margin="2,2,4,2" FontSize="11"
                                                           VerticalAlignment="Center" TextAlignment="Right"
                                                           FontFamily="{StaticResource F.Mono}"
                                                           Foreground="{StaticResource B.TextTertiary}"
                                                           Text="{Binding (ItemsControl.AlternationIndex),
                                                                  RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <CheckBox DockPanel.Dock="Right" Content="サブフォルダも含む" FontSize="11"
                                                          VerticalAlignment="Center" Margin="8,0,4,0"
                                                          IsChecked="{Binding Model.IncludeSubdirectories, Mode=TwoWay}"/>
                                                <TextBlock Margin="0,2" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Text="{Binding Model.Path, Mode=OneWay}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!-- 番号の意味は VOICEROID2 を使う人にしか関係しないため、有効時だけ出す。 -->
                                <TextBlock x:Name="FolderIndexHint" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="Collapsed" Foreground="{StaticResource B.TextMuted}"
                                           Text="左の番号は、「合成音声ソフト」タブの VOICEROID2「保存フォルダ番号」で指定する番号です。"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Style="{StaticResource AccentButton}" Margin="0,0,6,0" Click="OnAddFolder">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource I.Plus}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Margin="0,0,6,0"/>
                                            <TextBlock Text="追加…" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DangerButton}" Click="OnRemoveFolder">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource I.Trash}"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Margin="0,0,6,0"/>
                                            <TextBlock Text="削除" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="WatchStatusText" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource B.TextTertiary}" Text="—"/>
                            </StackPanel>
                        </Border>

                        <!-- ② 保存後の整理（後処理） -->
                        <Border Background="{StaticResource B.Surface}" CornerRadius="8" BorderBrush="{StaticResource B.Border}"
                                BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="② 保存後の整理（後処理）" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.TextPrimary}"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,8"
                                           Text="保存された「同名 wav + txt」を V-Adapter が引き取り、名前を整えます。保存ダイアログは操作しないため、合成音声ソフト側の設定を変える必要はありません。"/>
                                <CheckBox x:Name="PpEnableCheck" Content="保存されたファイルを整理する" Margin="0,0,0,10"
                                          Checked="OnPpToggled" Unchecked="OnPpToggled"/>

                                <StackPanel x:Name="PpBody">
                                    <TextBlock Text="ファイル名" FontSize="12" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="PpPresetCombo" SelectionChanged="OnPpPresetChanged" Margin="0,0,0,6">
                                        <ComboBoxItem Content="変更しない（保存された名前のまま）"/>
                                        <ComboBoxItem Content="日時 ＋ 元のファイル名"/>
                                        <ComboBoxItem x:Name="PpPresetSpeakerItem" Content="日時 ＋ 話者名 ＋ 元のファイル名"/>
                                        <ComboBoxItem Content="カスタム…"/>
                                    </ComboBox>

                                    <StackPanel x:Name="PpCustomPanel" Visibility="Collapsed" Margin="0,0,0,6">
                                        <TextBox x:Name="PpTemplateBox" FontFamily="{StaticResource F.Mono}"
                                                 TextChanged="OnPpTemplateChanged" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="挿入:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Foreground="{StaticResource B.TextMuted}"/>
                                            <Button Content="日時" Tag="{}{date}" Height="24" Padding="10,0" Margin="0,0,5,0" Click="OnPpInsertToken"/>
                                            <Button x:Name="PpInsertSpeakerButton" Content="話者名" Tag="{}{speaker}" Height="24" Padding="10,0" Margin="0,0,5,0" Click="OnPpInsertToken"/>
                                            <Button Content="元のファイル名" Tag="{}{name}" Height="24" Padding="10,0" Click="OnPpInsertToken"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="{StaticResource B.ControlBg}" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                        <TextBlock x:Name="PpPreviewText" FontSize="12" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource F.Mono}"
                                                   Foreground="{StaticResource B.TextSecondary}" Text="—"/>
                                    </Border>

                                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource B.TextMuted}"
                                               Text="話者名は「投げ込み」タブの話者ルールで判定します。ルールが無い連携環境では、ファイル名を「_」や「-」で区切った 2 番目の要素を話者名として扱います。判別できなかった場合、その部分は区切り文字ごと省かれます。"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ③ 整えた後の置き場所 -->
                        <Border Background="{StaticResource B.Surface}" CornerRadius="8" BorderBrush="{StaticResource B.Border}"
                                BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="③ 整えた後の置き場所（動画編集ソフトに読み込ませる場所）" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.TextPrimary}"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,8"
                                           Text="YMM4 のカスタムボイスフォルダなど、動画編集ソフトに監視させているフォルダを指定します。空欄なら移動せず、① の保存フォルダに置いたままにします。"/>
                                <StackPanel x:Name="PpDestBody">
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="参照…" Width="70" Margin="8,0,0,0" Click="OnPpBrowseDest"/>
                                        <TextBox x:Name="PpDestBox" VerticalContentAlignment="Center" TextChanged="OnPpDestChanged"/>
                                    </DockPanel>
                                    <CheckBox x:Name="PpSpeakerSubCheck" Content="話者名のサブフォルダへ振り分ける" Margin="0,0,0,3"
                                              Checked="OnPpToggled" Unchecked="OnPpToggled"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap"
                                               Text="話者ごとにフォルダを分けて置きます。話者を判定できなかったファイルはサブフォルダを作らずそのまま置きます。"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════ 合成音声ソフト ════════ -->
            <TabItem Header="合成音声ソフト">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Background="{StaticResource B.HoverBg}" CornerRadius="8" BorderBrush="{StaticResource B.Border}"
                                BorderThickness="1" Padding="14,11" Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="12"
                                       Foreground="{StaticResource B.TextSecondary}"
                                       Text="特定の合成音声ソフトだけに必要な設定をまとめています。該当のソフトを使っていない場合は、何も設定する必要はありません。"/>
                        </Border>

                        <Border Background="{StaticResource B.Surface}" CornerRadius="8" BorderBrush="{StaticResource B.Border}"
                                BorderThickness="1" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="VOICEROID2 (AITalk5系) の保存先解決" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.TextPrimary}"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,8"
                                           Text="ファイル命名規則を持たない VOICEROID2 等で使用します。組込マクロ「音声の保存」の VOICEROID2 用スクリプトを使う場合、ここにキャラクターと保存先を登録するだけで動作します（マクロ編集は不要）。マクロ動作ベースは明示フォルダ、AviUtl/AviUtl2 は「音声の保存」タブ① の保存フォルダの番号を使います。番号は同タブのフォルダ一覧の左端に表示されます（0起点）。"/>
                                <CheckBox x:Name="V2EnableCheck" Content="VOICEROID2 の保存先解決を有効にする" Margin="0,0,0,10"
                                          Checked="OnV2EnabledToggled" Unchecked="OnV2EnabledToggled"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="キャラクター名はユーザープリセット名の先頭一致で照合します（例:「紲星あかり - コピー」は「紲星あかり」として扱われます）。区切り文字の指定は不要です。"/>
                                <DockPanel Margin="0,0,0,4">
                                    <!-- DockPanel は最後の子が残り幅を占める。見出しを先に置き、ボタン群を右端へ寄せる
                                         （「話者ルール」の見出し行と同じ構造）。 -->
                                    <TextBlock Text="キャラクター別 保存先" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource AccentButton}" Margin="0,0,6,0" Click="OnV2AddChar">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource I.Plus}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" Margin="0,0,6,0"/>
                                                <TextBlock Text="行を追加" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="保存先を参照…" Width="110" Margin="0,0,6,0" Click="OnV2BrowseFolder"/>
                                        <Button Style="{StaticResource DangerButton}" Click="OnV2RemoveChar">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource I.Trash}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" Margin="0,0,6,0"/>
                                                <TextBlock Text="削除" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid x:Name="V2Grid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                          MaxHeight="220" GridLinesVisibility="Horizontal" RowHeight="26" Background="Transparent"
                                          BorderThickness="1" BorderBrush="{StaticResource B.Border}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="キャラクター名（UI表示名）" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="マクロ動作ベース保存先" Binding="{Binding MacroBaseFolder}" Width="2*"/>
                                        <DataGridTextColumn Header="保存フォルダ番号" Binding="{Binding MonitorFolderIndex}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>


            <!-- ════════ 対象アプリ ════════ -->
            <TabItem Header="対象アプリ">
                <StackPanel>
                    <Border Background="{StaticResource B.Surface}" CornerRadius="8" BorderBrush="{StaticResource B.Border}"
                            BorderThickness="1" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="対象アプリ管理" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource B.TextPrimary}"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource B.TextMuted}" TextWrapping="Wrap" Margin="0,3,0,10"
                                       Text="マクロの操作対象となる合成音声ソフトの登録内容（プロセス名・ウィンドウクラス・実行ファイル）を編集します。同梱の初期値でほとんどの環境はそのまま動作するため、通常は変更不要です。"/>
                            <Button HorizontalAlignment="Left" Height="32" Click="OnOpenTargetManager">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="13" Height="13" Stretch="Uniform" Data="{StaticResource I.Grid}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeLineJoin="Round" Margin="0,0,7,0"/>
                                    <TextBlock Text="対象アプリ管理を開く…" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
